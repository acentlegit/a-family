# ============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env.production in frontend/frontend/
# and fill in your actual values before building

# REQUIRED: Backend API URL (must end with /api or base without /api — see api.ts)
# Production (fami.live): https://api.fami.live/api
# Or EC2: https://your-ec2-host:5000/api
REACT_APP_API_BASE=https://api.fami.live/api

# Site origin (CORS / links reference)
REACT_APP_CLIENT_URL=https://www.fami.live

# ============================================
# DEFAULT USER CREDENTIALS (REQUIRED)
# ============================================
# Must match backend .env DEFAULT_USER_EMAIL and DEFAULT_USER_PASSWORD
# Users must type these credentials manually (login fields are empty)
REACT_APP_DEFAULT_USER_EMAIL=arakala1926
REACT_APP_DEFAULT_USER_PASSWORD=a1926$2026

# Build environment
NODE_ENV=production
