# ============================================
# PRODUCTION ENVIRONMENT FOR fami.live
# ============================================
# Copy this to frontend/frontend/.env.production
# and use it for building

# REQUIRED: Backend API URL
# Your API should be at: https://api.fami.live
REACT_APP_API_BASE=https://api.fami.live/api

# Frontend URL
REACT_APP_CLIENT_URL=https://www.fami.live

# ============================================
# DEFAULT USER CREDENTIALS (REQUIRED)
# ============================================
# Must match backend .env DEFAULT_USER_EMAIL and DEFAULT_USER_PASSWORD
# Users must type these credentials manually (login fields are empty)
REACT_APP_DEFAULT_USER_EMAIL=arakala1926
REACT_APP_DEFAULT_USER_PASSWORD=a1926$2026

# Build environment
NODE_ENV=production

# ============================================
# NOTES:
# ============================================
# - Replace api.fami.live with your actual API domain
# - If using EC2 IP, use: http://your-ec2-ip:5000/api
# - Make sure backend CORS allows https://www.fami.live
# - DEFAULT_USER_EMAIL and DEFAULT_USER_PASSWORD must match backend .env
